{
  "schemaVersion": 1,
  "id": "rosetta_library",
  "version": "${version}",
  "name": "${mod_name}",
  "description": ${mod_description},
  "authors": ${mod_authors},
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "mixins": ["rosetta.mixins.json", "rosetta-client.mixins.json"],
  "entrypoints": {
    "main": ["net.rasanovum.rosetta.loaders.fabric.RosettaFabric"],
    "client": ["net.rasanovum.rosetta.loaders.fabric.RosettaFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
