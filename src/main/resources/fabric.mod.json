{
  "schemaVersion": 1,
  "id": "rosetta_library",
  "version": "${version}",
  "name": "Rosetta",
  "description": ${mod_description},
  "authors": ${mod_authors},
  "contact": {
    "sources": "https://github.com/Rasa-Novum/Rosetta_Library"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "mixins": ["rosetta.mixins.json", "rosetta-client.mixins.json"],
  "entrypoints": {
    "main": ["net.rasanovum.rosetta.loaders.fabric.RosettaFabric"],
    "client": ["net.rasanovum.rosetta.loaders.fabric.RosettaFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
